# Copy to .env and paste your key (never commit .env)
OPENROUTER_API_KEY=
# Optional: primary model first, then fallbacks (all free, tool-calling capable)
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free

# Optional free backup provider (OpenAI-compatible), used only when OpenRouter's free quota is exhausted.
# Groq:   BACKUP_BASE_URL=https://api.groq.com/openai/v1
# Gemini: BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  BACKUP_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
BACKUP_BASE_URL=
BACKUP_API_KEY=
BACKUP_MODELS=
